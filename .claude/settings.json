{
  "permissions": {
    "allow": [
      "Bash(scripts/ledger.sh:*)",
      "Bash(./scripts/ledger.sh:*)",
      "Bash(scripts/job-session.sh list)",
      "Bash(./scripts/job-session.sh list)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/ledger.sh hook-start",
            "timeout": 35
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/ledger.sh hook-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/autosave.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
